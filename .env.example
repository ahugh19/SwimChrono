# AI assistant for the TriggerDrawer's "AI Interpret" button — optional.
# Copy this file to .env and fill in your own key. `.env` is gitignored and
# must never be committed. Any OpenAI-compatible chat-completion endpoint
# works — see "Configure the AI Assistant" in README.md.

# Required to enable the AI button (without it the button shows a warning)
VITE_AI_API_KEY=

# Optional — defaults shown below
VITE_AI_BASE_URL=https://api.deepseek.com
VITE_AI_MODEL=deepseek-chat
VITE_AI_PROVIDER=openai-compatible

# Optional backend URL for the legacy label-tool persistence API
# (leave empty to disable backend calls; the demo runs without it)
VITE_BACKEND_API_URL=
